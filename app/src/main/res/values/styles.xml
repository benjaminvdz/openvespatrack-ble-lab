<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VespaSim" parent="Theme.AnthroBios.Light" />
    <style name="Theme.AnthroBios.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:colorAccent">@color/anb_accent</item>
        <item name="android:colorPrimary">@color/anb_surface</item>
        <item name="android:colorPrimaryDark">@color/anb_chrome</item>
        <item name="android:textColorPrimary">@color/anb_text</item>
        <item name="android:textColorSecondary">@color/anb_muted</item>
        <item name="android:textColorHint">@color/anb_muted</item>
        <item name="android:colorBackground">@color/anb_page</item>
        <item name="android:colorButtonNormal">@color/anb_surface</item>
        <item name="android:colorControlNormal">@color/anb_border</item>
        <item name="android:colorControlActivated">@color/anb_accent</item>
        <item name="android:colorControlHighlight">@color/anb_accent_subtle</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/anb_page</item>
        <item name="android:statusBarColor">@color/anb_chrome</item>
        <item name="android:navigationBarColor">@color/anb_chrome</item>
        <item name="android:buttonStyle">@style/Widget.AnthroBios.Button</item>
    </style>
    <style name="Theme.AnthroBios.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:colorAccent">@color/anb_accent</item>
        <item name="android:colorPrimary">@color/anb_surface</item>
        <item name="android:colorPrimaryDark">@color/anb_chrome</item>
        <item name="android:textColorPrimary">@color/anb_text</item>
        <item name="android:textColorSecondary">@color/anb_muted</item>
        <item name="android:textColorHint">@color/anb_muted</item>
        <item name="android:colorBackground">@color/anb_page</item>
        <item name="android:colorButtonNormal">@color/anb_surface</item>
        <item name="android:colorControlNormal">@color/anb_border</item>
        <item name="android:colorControlActivated">@color/anb_accent</item>
        <item name="android:colorControlHighlight">@color/anb_accent_subtle</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/anb_page</item>
        <item name="android:statusBarColor">@color/anb_chrome</item>
        <item name="android:navigationBarColor">@color/anb_chrome</item>
        <item name="android:buttonStyle">@style/Widget.AnthroBios.Button</item>
    </style>
    <style name="Widget.AnthroBios.Button" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ibm_plex_mono_regular</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
